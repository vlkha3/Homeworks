{
	"name": "layout-review",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"check:formatting": "oxfmt --check .",
		"check:styles": "stylelint \"**/*.{css,scss,html,htm}\" --allow-empty-input",
		"fix:formatting": "oxfmt .",
		"fix:styles": "stylelint \"**/*.{css,scss,html,htm}\" --fix --allow-empty-input"
	},
	"devDependencies": {
		"oxfmt": "^0.72.0",
		"postcss-html": "^2.0.0",
		"stylelint": "^17.16.0",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-plugin-logical-css": "^2.1.0",
		"typescript": "~6.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.21.0",
			"onFail": "download"
		}
	}
}
